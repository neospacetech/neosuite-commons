{
  "name": "@neospacetech/neosuite-runtime",
  "version": "0.0.0",
  "description": "Framework-agnostic client runtime for NeoSuite: API client, problem errors, server-sent events, session, realtime and offline cache interfaces.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/neospacetech/neosuite-commons.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "default": "./src/react.tsx"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@neospacetech/neosuite-schema": "0.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
